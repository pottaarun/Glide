{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glide-test",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "GlideAgent", "class_name": "GlideAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GlideAgent"] }],
  "vars": { "GLIDE_TOKEN_KEY": "glide-test-only-encryption-key" }
}
